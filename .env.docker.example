# Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional built-in administrator account. Set both values or leave both blank.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Python backend: comma-separated browser origins; HTTPS except local development.
# Set the exact external origins, not Docker's internal address. Recreate the container after changes.
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000
# Domain only; origins must equal this domain or be its subdomains to use passkeys.
WEBAUTHN_RP_ID=localhost
# Keep the previous external origin during the first upgrade to label existing passkeys.
# PUBLIC_APP_ORIGIN=
# For a new unrelated domain: retain password/TOTP/recovery access, then register new passkeys.
# Old RP credentials stay listed but cannot authenticate on the new RP.

# Python authentication limits: shared IP 60/min, login account 10/min,
# and authenticated password/TOTP operations shared per user ID 10/min.
# SQLite buckets survive restarts. By default only the socket peer IP is used;
# X-Forwarded-For and X-Real-IP are NOT trusted. Docker reverse proxies may
# therefore conservatively share one IP quota for all clients.
# Explicitly trust only your actual proxy IPs/CIDRs (comma separated).
# Example: TRUSTED_PROXY_CIDRS=172.20.0.2/32,2001:db8::2/128
# Ensure the proxy appends/replaces X-Forwarded-For with the real peer address;
# only a trusted socket peer enables right-to-left trusted-hop stripping.
# Never trust all networks (0.0.0.0/0 or ::/0). Recreate container after changes.
TRUSTED_PROXY_CIDRS=
